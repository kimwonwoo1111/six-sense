<?xml version="1.0" encoding="UTF-8"?>
<!-- 각 방향 왕복 도로. 3차로, 50km/h 미만(13 m/s)이라 횡단보도 자동 생성 가능.
     방향(우리 현시): 1=북(N), 2=동(E), 3=남(S), 4=서(W) 진입. -->
<edges>
    <edge id="N_C" from="N" to="C" numLanes="3" speed="13.0"/>
    <edge id="C_N" from="C" to="N" numLanes="3" speed="13.0"/>
    <edge id="E_C" from="E" to="C" numLanes="3" speed="13.0"/>
    <edge id="C_E" from="C" to="E" numLanes="3" speed="13.0"/>
    <edge id="S_C" from="S" to="C" numLanes="3" speed="13.0"/>
    <edge id="C_S" from="C" to="S" numLanes="3" speed="13.0"/>
    <edge id="W_C" from="W" to="C" numLanes="3" speed="13.0"/>
    <edge id="C_W" from="C" to="W" numLanes="3" speed="13.0"/>
</edges>
